{
  "name": "deal-notes",
  "version": "0.1.0",
  "private": true,
  "description": "Notetaker: a personal AI meeting bot (Recall.ai + OpenAI) on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/*.test.ts --bundle --platform=node --format=esm --outdir=.test-build --out-extension:.js=.mjs --log-level=warning && node --test .test-build/*.mjs",
    "db:migrate:local": "wrangler d1 migrations apply deal-notes --local",
    "db:migrate:remote": "wrangler d1 migrations apply deal-notes --remote",
    "test:e2e": "bash test/e2e/run.sh"
  },
  "dependencies": {
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261024.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
